# ===== Server =====
PORT=3000
# Origin aplikasi Expo yang diizinkan (pisahkan dengan koma). Kosongkan untuk semua.
CORS_ORIGINS=

# ===== Midtrans Sandbox =====
# Ambil dari dashboard.sandbox.midtrans.com (JANGAN commit nilai asli).
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
# Opsional; default sudah ke endpoint sandbox.
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com/snap/v1
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com/v2

# ===== Firebase Admin =====
# Isi salah satu:
# 1) JSON service account dalam satu baris (JANGAN commit).
FIREBASE_SERVICE_ACCOUNT=
# 2) Path ke file service account (JANGAN commit file-nya).
GOOGLE_APPLICATION_CREDENTIALS=

# ===== Expo Push (opsional) =====
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
