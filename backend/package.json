{
  "name": "ppk1-payment-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend payment gateway Midtrans Sandbox untuk Aplikasi Praktikum PPK",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
